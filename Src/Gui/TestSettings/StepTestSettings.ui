        <property name="styleSheet">
         <string notr="true">
QTimeEdit {
    color: #333333;
    background: #FFFFFF;
    border: 1px solid #B9C0CB;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
QTimeEdit:hover {
    border-color: #94A0B1;
}
QTimeEdit:focus {
    border-color: #2563EB;
}
QTimeEdit:disabled {
    color: #94A0B1;
    background: #F7F8FA;
    border-color: #E2E6EC;
}
QTimeEdit::up-button, QTimeEdit::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    border-left: 1px solid #E2E6EC;
    background: #FFFFFF;
}
QTimeEdit::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}
QTimeEdit::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}
QTimeEdit::up-button:hover, QTimeEdit::down-button:hover {
    background: #F0F2F5;
}
QTimeEdit::up-button:pressed, QTimeEdit::down-button:pressed {
    background: #E2E6EC;
}
QTimeEdit::up-arrow {
    image: url(:/Src/Img/ChevronUp.svg);
    width: 10px;
    height: 7px;
}
QTimeEdit::down-arrow {
    image: url(:/Src/Img/ChevronDown.svg);
    width: 10px;
    height: 7px;
}
QTimeEdit::up-arrow:pressed {
    image: url(:/Src/Img/ChevronUpActive.svg);
}
QTimeEdit::down-arrow:pressed {
    image: url(:/Src/Img/ChevronDownActive.svg);
}
</string>
