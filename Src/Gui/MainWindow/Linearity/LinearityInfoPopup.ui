<?xml version="1.0" encoding="UTF-8"?>
<!--
  Всплывающая справка ⓘ «на каких данных посчитано» для панели способов
  линейности. Корень — QFrame со стилем section (role ставит
  LinearityMethodsPresenter: applyRoles() не трогает сам корень формы).
  Подписи — _Title, числа — моноширинным шрифтом прямо здесь (суффикс
  _Data ролью не является, поэтому шрифт из формы не перебивается QSS).
-->
